      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.text;\nconst chunkSize = 800;\nconst overlap = 100;\n\nlet chunks = [];\n\nfor (let i = 0; i < text.length; i += (chunkSize - overlap)) {\n  const chunk = text.slice(i, i + chunkSize);\n\n  chunks.push({\n    chunk: chunk,\n    chunkText: chunk   // 👈 additional field\n  });\n}\n\nreturn chunks.map(item => ({\n  json: item\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1952,
        -208
      ],
      "id": "1a74b48c-4811-4cff-b7e1-35862847f74d",
      "name": "Perform_Chunking"
    },
    {
      "parameters": {
        "jsCode": "// Collect all chunk texts\nconst allTexts = items.map(item => \n  item.json.chunkText || item.json.chunk || \"\"\n);\n\n// Join with newline (preserve record separation)\nlet combinedText = allTexts.join(\"\\n\");\n\n// Clean text (keep structure, remove noise)\ncombinedText = combinedText\n  .replace(/\\r/g, \"\")\n  .replace(/\\t/g, \" \")\n  .replace(/\\s+/g, \" \")\n  .trim();\n\n// Return single combined output\nreturn [\n  {\n    json: {\n      text: combinedText\n\n      \n    }\n  }\n];"
      },
